<?xml version="1.0" encoding="utf-8"?>
<!-- Device control for the SipLLM agent. Deliberately minimal: read the active
     window and click/scroll nodes. No gestures, screenshots, key filtering,
     touch exploration or web enhancements. Events are only used to tell when
     the screen has settled during an agent run; outside a run they are ignored. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/sipllm_accessibility_description"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged"
    android:accessibilityFlags="flagDefault"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:notificationTimeout="100"
    android:canRetrieveWindowContent="true" />
